# GitHub Configuration
# Required for local CLI runs only. In GitHub Actions, the built-in github.token is used automatically.
# Get your token from: https://github.com/settings/tokens
# Create a "Personal Access Token" with 'repo' and 'read:user' scopes
GITHUB_TOKEN=your_github_token_here

# Repository information (optional for testing, required for GitHub integration)
GITHUB_OWNER=your_github_owner_name
GITHUB_REPO=claude-code-reviewer

# Claude API Configuration (for future integration)
CLAUDE_API_KEY=your_claude_api_key_here