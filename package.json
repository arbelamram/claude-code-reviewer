{
  "type": "module",
  "name": "code-reviewer",
  "version": "1.3.0",
  "description": "AI-powered GitHub PR code reviewer using Claude and configurable coding standards",
  "main": "index.js",
  "scripts": {
    "prebuild": "node scripts/validate-status-context.mjs",
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "dev": "ts-node src/index.ts",
    "cli": "ts-node src/cli.ts",
    "review": "node dist/cli.js",
    "validate:constants": "node scripts/validate-status-context.mjs"
  },
  "keywords": ["code-review", "github-actions", "claude", "ai", "typescript", "pull-request"],
  "author": "Arbel Amram",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "dotenv": "^17.4.2",
    "js-yaml": "^4.1.1"
  }
}
